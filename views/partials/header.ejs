<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Escuela de Artes Marciales</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:'Segoe UI',sans-serif;background:#f0f2f5;color:#1a1a1a;min-height:100vh}
    nav{background:#1F3864;padding:0.8rem 2rem;box-shadow:0 2px 8px rgba(0,0,0,0.2);display:flex;align-items:center;justify-content:space-between}
    .nav-top{display:flex;align-items:center}
    nav .logo{color:#fff;font-size:1.2rem;font-weight:700;display:flex;align-items:center;gap:0.4rem}
    .nav-links{display:flex;gap:0.3rem;flex-wrap:wrap;align-items:center}
    .hamburger{display:none;background:none;border:none;color:#fff;font-size:1.6rem;cursor:pointer;padding:0.2rem 0.4rem;line-height:1;border-radius:5px;transition:background 0.2s}
    .hamburger:hover{background:rgba(255,255,255,0.15)}
    nav a{color:#fff;text-decoration:none;font-size:0.82rem;padding:0.4rem 0.7rem;border-radius:5px;transition:background 0.2s;display:inline-flex;align-items:center;gap:0.3rem}
    nav a:hover{background:rgba(255,255,255,0.15)}
    nav a.active{background:#fff;color:#1F3864;font-weight:600}
    .container{max-width:1050px;margin:1.5rem auto;padding:0 1rem}
    .card{background:#fff;border-radius:8px;padding:1.5rem;box-shadow:0 1px 4px rgba(0,0,0,0.06);margin-bottom:1.2rem}
    h2{color:#1F3864;margin-bottom:1rem;font-size:1.35rem;display:flex;align-items:center;gap:0.5rem}
    h2 i{font-size:1.4rem}
    .top-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:0.6rem}
    .table-wrap{overflow-x:auto}
    table{width:100%%;border-collapse:collapse}
    th{background:#1F3864;color:#fff;padding:0.65rem 0.8rem;text-align:left;font-size:0.82rem;font-weight:600}
    th:first-child{border-radius:5px 0 0 0}th:last-child{border-radius:0 5px 0 0}
    td{padding:0.65rem 0.8rem;border-bottom:1px solid #e5e7eb;font-size:0.85rem}
    tr:hover{background:#f0f4f8}
    .btn{display:inline-flex;align-items:center;gap:0.25rem;padding:0.4rem 0.9rem;border:none;border-radius:5px;cursor:pointer;text-decoration:none;font-size:0.82rem;color:#fff;font-weight:500;transition:opacity 0.2s}
    .btn:hover{opacity:0.85}
    .btn-primary{background:#1F3864}.btn-success{background:#166534}.btn-warning{background:#b45309}.btn-danger{background:#991b1b}
    .btn-sm{padding:0.3rem 0.6rem;font-size:0.78rem}
    .actions{display:flex;gap:0.3rem;align-items:center}
    .form-group{margin-bottom:1rem}
    .form-group label{display:block;margin-bottom:0.3rem;font-weight:600;font-size:0.88rem}
    .form-group input,.form-group select{width:100%%;padding:0.55rem 0.8rem;border:1px solid #d1d5db;border-radius:5px;font-size:0.92rem}
    .form-group input:focus,.form-group select:focus{outline:none;border-color:#1F3864;box-shadow:0 0 0 2px rgba(31,56,100,0.1)}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 1.2rem}
    .badge{display:inline-block;padding:0.2rem 0.6rem;border-radius:10px;font-size:0.75rem;font-weight:600}
    .badge-blue{background:#dbeafe;color:#1e40af}
    .badge-green{background:#dcfce7;color:#166534}
    .badge-red{background:#fde7e7;color:#991b1b}
    .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:0.8rem;margin-bottom:1.2rem}
    .stat-card{background:#fff;border-radius:8px;padding:1.2rem;box-shadow:0 1px 4px rgba(0,0,0,0.06);text-align:center;border-top:3px solid #1F3864}
    .stat-card .number{font-size:1.8rem;font-weight:700;color:#1F3864}
    .stat-card .label{font-size:0.78rem;color:#555;margin-top:0.2rem}
    @media(max-width:768px){
      nav{padding:0.8rem 1rem;display:block}
      .nav-top{display:flex;justify-content:space-between;align-items:center}
      .hamburger{display:flex;align-items:center;justify-content:center}
      .nav-links{display:none;flex-direction:column;width:100%;margin-top:0.5rem;gap:0.1rem}
      .nav-links.open{display:flex}
      .nav-links a{width:100%;padding:0.65rem 0.8rem}
      .form-grid{grid-template-columns:1fr}
      .card{padding:1rem}
      th,td{padding:0.5rem 0.6rem;font-size:0.8rem}
      .stats{grid-template-columns:1fr 1fr}
      .form-group input,.form-group select{font-size:1rem}
      .btn{min-height:38px}
      .btn-sm{min-height:34px;padding:0.35rem 0.6rem}
    }
    @media(max-width:600px){
      table th:first-child,table td:first-child{display:none}
      .actions{flex-wrap:wrap;gap:0.25rem}
    }
    @media(max-width:480px){
      nav{padding:0.6rem 1rem}
      .top-bar{flex-direction:column;align-items:flex-start}
      .stats{grid-template-columns:1fr 1fr}
      .stat-card{padding:0.8rem 0.6rem}
      .stat-card .number{font-size:1.5rem}
      h2{font-size:1.1rem}
      .container{margin:0.8rem auto}
    }
    @media(max-width:360px){
      .stats{grid-template-columns:1fr}
    }
  </style>
</head>
<body>
<nav>
  <div class="nav-top">
    <div class="logo"><i class="bi bi-trophy"></i> Escuela Artes Marciales</div>
    <button class="hamburger" id="menu-btn" onclick="toggleMenu()"><i class="bi bi-list" id="menu-icon"></i></button>
  </div>
  <div class="nav-links" id="nav-links">
    <a href="/"><i class="bi bi-speedometer2"></i> Inicio</a>
    <a href="/usuarios"><i class="bi bi-key"></i> Usuarios</a>
    <a href="/instructores"><i class="bi bi-person-badge"></i> Instructores</a>
    <a href="/alumnos"><i class="bi bi-people"></i> Alumnos</a>
    <a href="/cinturones"><i class="bi bi-award"></i> Cinturones</a>
    <a href="/avances"><i class="bi bi-graph-up"></i> Avances</a>
  </div>
</nav>
<div class="container">
