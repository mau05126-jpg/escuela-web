  </div>
</div>

<div id="modal-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:10px;padding:2rem;max-width:380px;width:90%;box-shadow:0 8px 30px rgba(0,0,0,0.2);text-align:center">
    <i class="bi bi-exclamation-triangle" style="font-size:2.5rem;color:#991b1b"></i>
    <h3 style="margin:0.8rem 0 0.4rem;color:#1a1a1a">¿Eliminar registro?</h3>
    <p style="color:#555;font-size:0.9rem;margin-bottom:1.5rem">Esta acción no se puede deshacer.</p>
    <div style="display:flex;gap:0.8rem;justify-content:center">
      <button onclick="cerrarModal()" class="btn btn-primary">Cancelar</button>
      <button id="modal-confirmar" class="btn btn-danger">Eliminar</button>
    </div>
  </div>
</div>

<script>
  function toggleMenu() {
    const links = document.getElementById('nav-links');
    const icon = document.getElementById('menu-icon');
    links.classList.toggle('open');
    icon.className = links.classList.contains('open') ? 'bi bi-x' : 'bi bi-list';
  }

  function abrirModal(btn) {
    document.getElementById('modal-overlay').style.display = 'flex';
    document.getElementById('modal-confirmar').onclick = function() {
      btn.closest('form').submit();
    };
  }
  function cerrarModal() {
    document.getElementById('modal-overlay').style.display = 'none';
  }
</script>

</body>
</html>
