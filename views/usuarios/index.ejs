<%- include('../partials/header') %>
<div class="card">
  <div class="top-bar"><h2><i class="bi bi-key"></i> Usuarios</h2><a href="/usuarios/crear" class="btn btn-success">+ Nuevo</a></div>
  <div class="table-wrap"><table>
    <thead><tr><th>ID</th><th>Usuario</th><th>Correo</th><th>Rol</th><th>Acciones</th></tr></thead>
    <tbody><% usuarios.forEach(u => { %>
      <tr><td><%= u.id_usuario %></td><td><%= u.nombre_usuario %></td><td><%= u.correo %></td>
      <td><span class="badge <%= u.rol === 0 ? 'badge-green' : 'badge-blue' %>"><%= u.rol === 0 ? 'Admin' : 'Instructor' %></span></td>
      <td class="actions"><a href="/usuarios/editar/<%= u.id_usuario %>" class="btn btn-warning btn-sm">Editar</a>
      <form action="/usuarios/eliminar/<%= u.id_usuario %>" method="POST" style="display:inline"><button type="button" class="btn btn-danger btn-sm" onclick="abrirModal(this)">Eliminar</button></form></td></tr>
    <% }) %></tbody>
  </table></div>
</div>
<%- include('../partials/footer') %>
