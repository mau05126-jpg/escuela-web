<%- include('../partials/header') %>
<div class="card">
  <h2><i class="bi bi-key"></i> Editar Usuario</h2>
  <form action="/usuarios/actualizar/<%= usuario.id_usuario %>" method="POST">
    <div class="form-grid">
      <div class="form-group"><label>Nombre de usuario</label><input type="text" name="nombre_usuario" value="<%= usuario.nombre_usuario %>" required></div>
      <div class="form-group"><label>Correo</label><input type="email" name="correo" value="<%= usuario.correo %>"></div>
      <div class="form-group"><label>Contraseña (dejar vacío para no cambiar)</label><input type="password" name="contrasena"></div>
      <div class="form-group"><label>Rol</label><select name="rol"><option value="0" <%= usuario.rol===0?'selected':'' %>>Administrador</option><option value="1" <%= usuario.rol===1?'selected':'' %>>Instructor</option></select></div>
    </div>
    <button class="btn btn-success">Actualizar</button> <a href="/usuarios" class="btn btn-primary">Cancelar</a>
  </form>
</div>
<%- include('../partials/footer') %>
