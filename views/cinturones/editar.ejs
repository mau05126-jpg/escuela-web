<%- include('../partials/header') %>
<div class="card">
  <h2><i class="bi bi-award"></i> Editar Cinturón</h2>
  <form action="/cinturones/actualizar/<%= cinturon.id_cinturon %>" method="POST">
    <div class="form-grid">
      <div class="form-group"><label>Nombre del cinturón</label><input type="text" name="nombre_cinturon" value="<%= cinturon.nombre_cinturon %>" required></div>
      <div class="form-group"><label>Orden</label><input type="number" name="orden" value="<%= cinturon.orden %>" required></div>
    </div>
    <button class="btn btn-success">Actualizar</button> <a href="/cinturones" class="btn btn-primary">Cancelar</a>
  </form>
</div>
<%- include('../partials/footer') %>
