<%- include('../partials/header') %>
<div class="card">
  <div class="top-bar"><h2><i class="bi bi-people"></i> Alumnos</h2><a href="/alumnos/crear" class="btn btn-success">+ Nuevo</a></div>
  <div class="table-wrap"><table>
    <thead><tr><th>ID</th><th>Nombre</th><th>Nacimiento</th><th>Inscripción</th><th>Teléfono</th><th>Cinturón</th><th>Acciones</th></tr></thead>
    <tbody><% alumnos.forEach(a => { %>
      <tr><td><%= a.id_alumno %></td><td><%= a.nombre %></td>
      <td><%= a.fecha_nacimiento ? a.fecha_nacimiento.split('-').reverse().join('/') : '' %></td>
      <td><%= a.fecha_inscripcion ? a.fecha_inscripcion.split('-').reverse().join('/') : '' %></td>
      <td><%= a.telefono_contacto %></td>
      <td><span class="badge badge-blue"><%= a.Cinturon ? a.Cinturon.nombre_cinturon : 'Sin asignar' %></span></td>
      <td class="actions"><a href="/alumnos/editar/<%= a.id_alumno %>" class="btn btn-warning btn-sm">Editar</a>
      <form action="/alumnos/eliminar/<%= a.id_alumno %>" method="POST" style="display:inline"><button type="button" class="btn btn-danger btn-sm" onclick="abrirModal(this)">Eliminar</button></form></td></tr>
    <% }) %></tbody>
  </table></div>
</div>
<%- include('../partials/footer') %>
