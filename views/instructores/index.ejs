<%- include('../partials/header') %>
<div class="card">
  <div class="top-bar"><h2><i class="bi bi-person-badge"></i> Instructores</h2><a href="/instructores/crear" class="btn btn-success">+ Nuevo</a></div>
  <div class="table-wrap"><table>
    <thead><tr><th>ID</th><th>Nombre</th><th>Especialidad</th><th>Teléfono</th><th>Usuario</th><th>Acciones</th></tr></thead>
    <tbody><% instructores.forEach(i => { %>
      <tr><td><%= i.id_instructor %></td><td><%= i.nombre %></td><td><%= i.especialidad %></td><td><%= i.telefono %></td>
      <td><%= i.Usuario ? i.Usuario.nombre_usuario : 'N/A' %></td>
      <td class="actions"><a href="/instructores/editar/<%= i.id_instructor %>" class="btn btn-warning btn-sm">Editar</a>
      <form action="/instructores/eliminar/<%= i.id_instructor %>" method="POST" style="display:inline"><button type="button" class="btn btn-danger btn-sm" onclick="abrirModal(this)">Eliminar</button></form></td></tr>
    <% }) %></tbody>
  </table></div>
</div>
<%- include('../partials/footer') %>
